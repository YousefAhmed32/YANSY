# Server Production Environment - Hostinger VPS
# Copy to .env on the server (or use ecosystem env_production)

PORT=5000
NODE_ENV=production

# Database (MONGODB_URI preferred; MONGO_URI also supported)
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/yansy?retryWrites=true&w=majority
# Or local: mongodb://localhost:27017/yansy

# JWT - generate a strong secret: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_STRONG_SECRET
JWT_EXPIRES_IN=7d

# Frontend URL for CORS and cookies (HTTPS required in production)
CLIENT_URL=https://yansytech.com

# Optional: Cloudinary
# CLOUD_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Stripe (billing/webhook — required for /api/billing to work at all in prod)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Google OAuth ("Sign in with Google") — must match client's VITE_GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# OpenAI (public AI Support Chat widget)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# Meta Conversions API — must match client's VITE_META_PIXEL_ID
# META_PIXEL_ID=
# META_CAPI_ACCESS_TOKEN=

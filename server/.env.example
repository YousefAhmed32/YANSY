# ─────────────────────────────────────────────────────────────────────────────
# YANSY Server — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/yansy
# MongoDB Atlas:
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/yansy?retryWrites=true&w=majority

# ── Authentication ────────────────────────────────────────────────────────────
# Generate strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-this
JWT_EXPIRES_IN=7d

# ── CORS / Client URL ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
# Production: CLIENT_URL=https://yansytech.com

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Option A: Service name (Gmail, Outlook, etc.)
# SMTP_SERVICE=Gmail
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password

# Option B: Custom SMTP host
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key

# The "From" address shown in emails
SMTP_FROM=YANSY <noreply@yansytech.com>

# ── Media storage ─────────────────────────────────────────────────────────────
# All uploaded files (portfolio images/video/audio, client logos, homepage
# showcase video, intro video, project attachments, AI-chat attachments) are
# stored in MongoDB GridFS — no separate config needed, it uses MONGODB_URI
# above. Served back at GET /api/media/:id. See server/media/.

# ── Base URL (used for local file links in development) ───────────────────────
BASE_URL=http://localhost:5000

# ── Stripe (billing & payments) ───────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Get from: stripe listen --forward-to localhost:5000/api/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Claude AI (by Anthropic) — used for internal portal features ──────────────
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...
AI_MAX_TOKENS=2048
AI_RATE_LIMIT_PRO=20
AI_RATE_LIMIT_ENTERPRISE=100

# ── OpenAI — used for public AI Support Chat widget ───────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...
# Model: gpt-4o-mini (default, cost-efficient) | gpt-4o (premium)
OPENAI_MODEL=gpt-4o-mini
# Embedding model for knowledge-base search (utils/openaiService.js)
OPENAI_EMBED_MODEL=text-embedding-3-small

# ── Google OAuth ("Sign in with Google") ──────────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
# Must match the client's VITE_GOOGLE_CLIENT_ID (same OAuth client, web application type).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Meta Conversions API (server-side event tracking, complements the browser Pixel) ──
# Get from: Meta Events Manager → your Pixel → Settings → Conversions API → Generate Access Token
# Must match the client's VITE_META_PIXEL_ID. Leave both unset to keep server-side events disabled.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

